# Required by the Google ADK orchestrator (unless you use a compatible route).
GOOGLE_API_KEY=

# Required by the OpenAI-based framework workers when they are present.
OPENAI_API_KEY=

# Optional local OpenAI-compatible router for the orchestrator.
OMNIROUTE_ENABLED=1
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
ORCHESTRATOR_MODEL=auto
WORKER_MODEL=auto

# Optional execution limits.
# WORKER_TIMEOUT_S=300
# QA_TIMEOUT_S=150
# QA_HEADLESS=1
